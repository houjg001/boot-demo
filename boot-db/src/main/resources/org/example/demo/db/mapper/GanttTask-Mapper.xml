<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.demo.db.mapper.GanttTaskMapper">

  <select id="queryGanttTasks" parameterType="java.lang.Integer" resultMap="BaseResultMap">
    select 
    <include refid="Base_Column_List" />
    from t_gantt_tasks where del_flag = 0
  </select>

  <delete id="deleteGanttTaskById" parameterType="java.lang.Integer">
    UPDATE t_gantt_tasks SET del_flag = 1
    WHERE id IN
    <foreach collection='ids' item='id' open='(' separator=',' close=')'>
      #{id}
    </foreach>
  </delete>
</mapper>