<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.demo.db.mapper.AddressMapper">

    <resultMap id="AddressResult" type="org.example.demo.api.dto.AddressDto">
        <id column="address_id" jdbcType="BIGINT" property="addressId"/>
        <result column="addr" jdbcType="VARCHAR" property="addr"/>
        <result column="postcode" jdbcType="VARCHAR" property="postcode"/>
    </resultMap>
    <select id="queryAddressByUserId" resultMap="AddressResult">
        SELECT ad.address_id,ad.addr,ad.postcode FROM t_users_addresses ua
        JOIN t_addresses ad on ua.address_id=ad.address_id
        WHERE ua.user_id=#{userId}
    </select>
</mapper>